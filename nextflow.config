// nextflow.config for use entire pipeline
// You will need to set the parameters below to match your environment and analysis needs
// Thanks for using this pipeline - Connor Murray, June 2025

// Define parameters
params {

    // General parameters
    threads = 8
    memory = '30 GB'
    partition = 'standard'
    account = 'manichaikul' // I am using the SLURM manager for job scheduling
    
    // Directories
    wd = "/standard/vol185/TOPMed/Freeze_10b/88293/topmed-dcc/exchange/phs001217_TOPMed_WGS_GenSalt/Combined_Study_Data/Genotypes/freeze.10b/phased"
    out = "/scratch/csm6hg/nextflow_dna/output"
    scripts_dir = "/scratch/csm6hg/nextflow_dna/scripts"

    // Raw gene count data - RNA matrix
    gene_count_file = "/standard/vol185/TOPMed/TOPCHef/82214/topmed-dcc/exchange/phs002038_TOPMed_TOPCHeF/Omics/RNASeq/release3/TOPMed_Taylor_P4.RNASeQCv2.3.6_gene_reads.gct.gz"
    
    // Metadata - sample and participant information
    samp = "/scratch/csm6hg/metadata/topchef_samples_bcf.txt"
    sample_participant_map = "/scratch/csm6hg/metadata/sample_participant_map"
    metadata = "/scratch/csm6hg/metadata/metadata_10_17_2024_CSM.txt"
    chrom_file = "/scratch/csm6hg/metadata/chromosomes" // List of human chromosomes, no header

    // Script inputs
    gtf = "/scratch/csm6hg/genome_files/gencode.v34.GRCh38.annotation.gtf"
    gtf_streamlined = "/scratch/csm6hg/genome_files/gencode.v34.GRCh38.ERCC.genes.collapsed.streamlined.RDS"
    mapp_file = "/scratch/csm6hg/crossmap-nextflow/output/gene-mappability/gene_mappability/gene_mappability.txt"
    snp_mapp_file = "/scratch/csm6hg/crossmap-nextflow/output/snp-mappability/snp_mappability_36mer_2mismatch_1mapp.bed.gz"
    
    // GWAS inputs - specific to this project and coloc analyses
    gwas_levin = "/scratch/csm6hg/data/HF-multiancestry-maf0.01.tsv.gz"
    gwas_shah = "/scratch/csm6hg/data/ShahS_31919418_HeartFailure.gz"
    gwas_jurgens = "/scratch/csm6hg/data/DCM_GWAS/Jurgens_DCM_GWAS_META_BiobanksOnly.tsv.gz"

    // Output titles - VCF, Bed, and other files
    gtf_name = "gencode.v34.GRCh38.genes.collapsed.TSS"
    out_vcf_full =  "freeze.10b.pass_only.snps_indels50_mac1.phased.TOPchef.vcf.gz"
    out_vcf_filt = "filt.thin250.TOPchef.vcf.gz"
    king_bed_out = "filt.maf0.01_phased.TOPchef"
    dna_outliers = "dna_outliers.txt"
    rna_outliers = "rna_outliers.txt"
    eqtl_out = "filt.1.17.25.TOPchef"

    // Output - PCA and GDS objects
    gds_filename = "filt.thin250.TOPchef.gds"
    pca_rds = "pca.genome.filt.thin250.maf0.05.rds"
    pca_plot = "pc1_6_selfreportrace_filtsnps_maf0.05.png"
    tensorqtl_pca = "filt_dna_pc1_5_topchef.txt"
}

// Define profiles for slurm execution environment
profiles {
    slurm {
        process {
            executor = 'slurm' // Use SLURM as the executor
            clusterOptions = "--partition=${params.partition} \
            --account=${params.account}" // SLURM partition, account
            cpus = "${params.threads}" // Number of threads per job
            memory = "${params.memory}" // Memory per job
            errorStrategy = 'finish'
        }
    }
}

// Container stuff
apptainer.enabled = true
apptainer.autoMounts = true
apptainer.pullTimeout = '60m'

// Define default process settings
process {
    // Set default resource allocations
    cpus = "${params.threads}"
    memory = "${params.memory}"
    errorStrategy = 'finish'
}

// Diagram configuration
dag {
    enabled = true
    file = 'flowchart.png'
    format = 'png'
}

// Report configuration
report {
    enabled = true
    file = 'report.html'
}

// Overwrite existing DAG and report files
dag.overwrite = true
report.overwrite = true
