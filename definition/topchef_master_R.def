Bootstrap: docker
From: rocker/tidyverse:4.3.1

%environment
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export PATH=/usr/local/bin:$PATH

%post
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libncurses5-dev liblzma-dev libxml2-dev libssl-dev \
        tar gzip unzip libgsl-dev libcurl4-openssl-dev \
        libbz2-dev zlib1g-dev bcftools htslib wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*
    
    echo "r <- getOption('repos'); r['CRAN'] <- 'http://cran.us.r-project.org'; options(repos = r);" \
        >> /root/.Rprofile

    # Install R packages
    Rscript -e "install.packages(c('remotes','devtools','ggforce','BiocManager','foreach',
      'parallel','purrr','FactoMineR','susieR','data.table',
      'argparse','ggrepel','patchwork','httr','arrow'),
      dependencies=TRUE)"

    Rscript -e "remotes::install_github('chr1swallace/coloc@main')"
    Rscript -e "BiocManager::install('SeqArray', ask=FALSE, update=FALSE)"
    Rscript -e "BiocManager::install('SNPRelate', ask=FALSE, update=FALSE)"
    Rscript -e "devtools::install_github('heatherjzhou/PCAForQTL')"

%runscript
    exec R "$@"
