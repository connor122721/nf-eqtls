Bootstrap: docker
From: mambaorg/micromamba:latest

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export CONDA_DEFAULT_ENV=leafcutter
    export PATH=/opt/conda/envs/leafcutter/bin:$PATH
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export PYTHONNOUSERSITE=1

%post
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:$PATH

    # Lock compatible versions explicitly
    micromamba create -y -n leafcutter -c conda-forge \
        python=3.11 \
        numpy=1.26.4 \
        pandas \
        scipy \
        matplotlib \
        seaborn \
        scikit-learn=1.4.2

    # Make sure PATH is set inside container
    echo 'export PATH=/opt/conda/envs/leafcutter/bin:$PATH' >> /environment
    echo 'export PYTHONNOUSERSITE=1' >> /environment

%runscript
    unset PYTHONPATH
    export PATH=/opt/conda/envs/leafcutter/bin:$PATH
    exec python "$@"